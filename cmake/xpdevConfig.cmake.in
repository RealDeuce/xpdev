@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/xpdevFeatures.cmake")

set(xpdev_FOUND TRUE)
set(xpdev_audio_FOUND ${xpdev_AUDIO_ENABLED})
set(xpdev_comio_FOUND TRUE)
set(xpdev_encode_FOUND TRUE)
set(xpdev_hash_FOUND TRUE)
foreach(component IN LISTS xpdev_FIND_COMPONENTS)
	if(NOT component MATCHES "^(audio|comio|encode|hash)$")
		set(xpdev_${component}_FOUND FALSE)
	endif()
endforeach()
check_required_components(xpdev)
if(NOT xpdev_FOUND)
	if("audio" IN_LIST xpdev_FIND_COMPONENTS AND NOT xpdev_audio_FOUND)
		set(xpdev_NOT_FOUND_MESSAGE
			"This xpdev installation was built without an audio backend")
	else()
		set(xpdev_NOT_FOUND_MESSAGE
			"xpdev does not provide one or more requested components")
	endif()
	return()
endif()

include(CMakeFindDependencyMacro)
if(@XPDEV_USE_SYSTEM_PTHREADS@)
	find_dependency(Threads)
endif()

if(@XPDEV_CONFIG_NEEDS_SDL2@)
	find_dependency(SDL2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xpdevTargets.cmake")
